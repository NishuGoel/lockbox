{
  "manifest_version": 3,
  "name": "lockbox",
  "version": "0.1.0",
  "description": "Fill and save logins with your lockbox password manager.",
  "key": "",
  "minimum_chrome_version": "127",
  "permissions": ["nativeMessaging", "storage", "webNavigation", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "lockbox",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "fill": { "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" }, "description": "Fill the login on this page" }
  }
}
